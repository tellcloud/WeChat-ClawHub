# WeChat-ClawHub 环境变量模板
#
# 使用方法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）：
#   cp .env.example .env
#
# 本项目已引入 python-dotenv：每次运行 python main.py 时会自动加载
# 项目根目录的 .env，无需手动导出；已设置的系统环境变量优先级更高，
# .env 仅作为缺省值。.env 缺失时静默跳过，不影响运行。

# ---------------------------------------------------------------------------
# 微信 ClawBot / iLink Bot API（transport 层）
# ---------------------------------------------------------------------------

# Bot API 网关地址（默认 https://ilinkai.weixin.qq.com ）
WECHAT_BASE_URL=

# CDN 媒体下载地址（默认 https://novac2c.cdn.weixin.qq.com/c2c ）
WECHAT_CDN_BASE_URL=

# 渠道版本号（默认 2.1.1 ）
WECHAT_CHANNEL_VERSION=

# 登录态（token）本地存储路径（默认 Local/wechat_credentials.json ）
WECHAT_TOKEN_STORE=

# 路由标签（默认空，可选 SKRouteTag ）
WECHAT_ROUTE_TAG=

# ---------------------------------------------------------------------------
# AI 对话模块（GLM / 智谱，ai/providers/glm.py）
# ---------------------------------------------------------------------------

# 智谱开放平台 API Key（必填，否则 AI 功能回复引导配置提示）
# 获取地址：https://open.bigmodel.cn/ （控制台 → API keys）
GLM_API_KEY=

# 通用 LLM Key 兜底：未设置 GLM_API_KEY 时读取 LLM_API_KEY
# LLM_API_KEY=

# API 基础地址（默认 https://open.bigmodel.cn/api/paas/v4 ）
# GLM_BASE_URL=

# 模型名称（默认 glm-4-flash ；可换 glm-4-plus / glm-4-air 等）
# GLM_MODEL=

# 请求超时秒数（默认 30 ）
# GLM_TIMEOUT=

# 失败重试次数（默认 2 ，不含首次，指数退避）
# GLM_MAX_RETRIES=
